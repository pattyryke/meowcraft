      { "name": "Timberella",              "source": "hangar",   "project": "timberella",         "jar": "^timberella" },
      { "name": "Vault",                   "source": "github",   "repo": "MilkBowl/Vault", "asset": "^Vault\\.jar$", "jar": "^Vault[-.]" }
    ],
    "datapacks": [
      { "name": "Meowcraft Silly Stats", "source": "custom", "file": "meowcraft_stats.zip", "notes": "Copy of meowcraft-server-tools/datapacks/meowcraft_stats.zip in this repo - goes in world/datapacks" }
