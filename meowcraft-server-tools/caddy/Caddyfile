# The live map block for the Caddy that already runs on the Pi (~/docker/core/caddy/Caddyfile).
# This is a copy for reference: the README ("Map on https") says how to add it there.
# DuckDNS sends every *.meowcraft-server.duckdns.org name home, so map. needs no extra DuckDNS setup.

map.meowcraft-server.duckdns.org {
	encode zstd gzip

	# Lets the Meowcraft website read the live player list from BlueMap.
	header Access-Control-Allow-Origin "https://pattyryke.github.io"

	# BlueMap's web server, reached through the Pi's home network address.
	reverse_proxy 192.168.0.69:8100
}
