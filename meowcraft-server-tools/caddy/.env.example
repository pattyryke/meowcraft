# Copy this file to .env (cp .env.example .env) and fill it in. .env is never uploaded to GitHub.

# Your DuckDNS address. Friends join Minecraft with it, and the map is at https://<this>.
MEOWCRAFT_HOST=meowcraft.duckdns.org

# BlueMap's port on the Pi (webserver.conf in the BlueMap plugin folder). 8100 unless you changed it.
BLUEMAP_PORT=8100

# DuckDNS: the part before .duckdns.org, and the token from the top of duckdns.org once logged in.
SUBDOMAINS=meowcraft
TOKEN=paste-your-duckdns-token-here
# Your time zone, only used in the DuckDNS log (e.g. America/Chicago).
TZ=Etc/UTC
